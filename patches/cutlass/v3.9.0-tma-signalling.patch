+  CUTLASS_DEVICE
+  void ooverlap_signal_done_(OoverlapCoopSignal const& sig) {
+    if (!sig.enabled()) {
+      return;
+    }
+  
+    int* tile_done = sig.MM + sig.num_segments;
+  
+    if (sig.debug != nullptr) {
+      atomicAdd(&sig.debug[sig.tile], 1);
+    }
+  
+    int old = atomicAdd(&tile_done[sig.tile], 1);
+ 
+    if (old == sig.expected - 1) {
+      __threadfence();
+    
+      int seg = 0;
+      int running = 0;
+      int tile_num = 0;
+    
+      for (int s = 0; s < sig.num_segments; ++s) {
+        int next = running + sig.cseg[s];
+    
+        if (sig.tile >= running && sig.tile < next) {
+          seg = s;
+        }
+    
+        running = next;
+      }
+    
+      tile_num = running;
+    
+      atomicAdd(&sig.MM[seg], 1);
+    
+      if (sig.if_monitor) {
+        int* monitor_counter =
+            sig.MM + sig.num_segments + tile_num;
+    
+        int* monitor_order = monitor_counter + 1;
+    
+        int global_order = atomicAdd(monitor_counter, 1);
+    
+        cutlass::arch::global_store<int, sizeof(int)>(
+            global_order,
+            reinterpret_cast<void*>(monitor_order + sig.tile),
+            true);
+      }
+    }
+  }
